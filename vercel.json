{
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/:lang(ar|tr)/privacy",
      "destination": "/:lang/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/:lang(ar|tr)/terms",
      "destination": "/:lang/terms-of-service",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/ar/family-signup",
      "permanent": false
    },
    {
      "source": "/:lang(ar|tr)/signup",
      "destination": "/:lang/family-signup",
      "permanent": false
    },
    {
      "source": "/sponsorships",
      "destination": "/sponsor-orphan",
      "permanent": false
    },
    {
      "source": "/:lang(ar|tr)/sponsorships",
      "destination": "/:lang/sponsor-orphan",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
